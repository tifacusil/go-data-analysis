# HTTP
ANALYSIS__HOST=0.0.0.0
ANALYSIS__HTTP_PORT=8080
ANALYSIS__ROUTE_PREFIX=

# gRPC (server-to-server; not exposed through Nginx)
ANALYSIS__GRPC_PORT=50051
ANALYSIS__GRPC_MAX_WORKERS=10

# Service identity
ANALYSIS__INSTANCE_ID=data-analysis-01
ANALYSIS__VERSION=1.0.0
ANALYSIS__ENV=dev

# Redis
ANALYSIS__REDIS__HOST=redis
ANALYSIS__REDIS__PORT=6379
ANALYSIS__REDIS__PASSWORD=changeme_redis
ANALYSIS__REDIS__CACHE_TTL_SECONDS=3600

# Consul
ANALYSIS__CONSUL__HOST=consul-1
ANALYSIS__CONSUL__PORT=8500
ANALYSIS__CONSUL__TOKEN=

# data-management ReadingService (gRPC). Reemplaza el acceso directo pymysql.
# DNS de k8s; sin Consul. La llamada saliente lleva timeout + retry + breaker.
DATA_MANAGEMENT_GRPC_ADDR=data-management:9090
DATA_MANAGEMENT_CALL_TIMEOUT_SECONDS=5
DATA_MANAGEMENT_RETRY_BACKOFF_SECONDS=1,5,30
DATA_MANAGEMENT_BREAKER_FAIL_THRESHOLD=3
DATA_MANAGEMENT_BREAKER_RESET_SECONDS=30
